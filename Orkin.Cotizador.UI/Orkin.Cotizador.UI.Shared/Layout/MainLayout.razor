@implements IDisposable

<MudThemeProvider Theme="Tema" />
<MudDialogProvider />
<MudSnackbarProvider />

@* MudPopoverProvider tiene que estar en el layout, no en la página. Los popovers (tooltip,
   menú del MudSelect, select múltiple) se renderizan en un contenedor único del layout en vez
   de en el lugar del componente que los pidió: por eso van acá y no en cada pantalla. Sin él,
   MudBlazor avisa por consola y el tooltip simplemente no aparece —que es la clase de falla
   que uno no nota porque lo que falta es algo que nunca estuvo. *@
<MudPopoverProvider />

<MudLayout>
    @if (MostrarSidebar)
    {
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-3">ORKIN</MudText>
            <MudSpacer />
            @* La campana aparece solo con NOTIFICACIONES.VER. El badge cuenta las avisos
               enviados no leídos que devuelve la API; si la consulta falla, se conserva el
               último número conocido en vez de tumbar el layout. *@
            @if (TienePermiso("NOTIFICACIONES.VER"))
            {
                <MudTooltip Text="@(_noLeidas == 0 ? "No tiene notificaciones sin leer" : $"{_noLeidas} notificación(es) sin leer")">
                    <div style="position:relative;display:inline-flex;">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                       Color="Color.Inherit"
                                       OnClick="VerNotificaciones"
                                       aria-label="Notificaciones" />
                        @if (_noLeidas > 0)
                        {
                            <span style="position:absolute;top:0;right:0;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#E31837;color:white;font-size:11px;line-height:18px;text-align:center;font-weight:600;">
                                @(_noLeidas > 99 ? "99+" : _noLeidas.ToString())
                            </span>
                        }
                    </div>
                </MudTooltip>
            }
            <MudText Typo="Typo.body2" Class="mx-3">@_nombreUsuario</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="CerrarSesion" aria-label="Cerrar sesión" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerAbierto" Elevation="2" ClipMode="DrawerClipMode.Always">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Color="Color.Primary">ORKIN</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

                @if (TienePermiso("COTIZACIONES.VER"))
                {
                    <MudNavLink Href="/cotizaciones" Icon="@Icons.Material.Filled.RequestQuote">Cotizaciones</MudNavLink>
                }
                @if (TienePermiso("CATALOGOS.VER"))
                {
                    @* Catálogos del ERP en vivo (D-24): mismas opciones del submenú legacy
                       (FrmprincipalCatalogos) más las que consume el cotizador. Se presentan
                       como grillas de solo lectura; no hay tablas espejo ni carga local. *@
                    <MudNavGroup Title="Catálogos" Icon="@Icons.Material.Filled.List" Expanded="true">
                        <MudNavLink Href="/catalogos/clientes" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
                        <MudNavLink Href="/catalogos/articulos" Icon="@Icons.Material.Filled.Inventory">Artículos</MudNavLink>
                        <MudNavLink Href="/catalogos/unidades-medida" Icon="@Icons.Material.Filled.Numbers">Unidades de medida</MudNavLink>
                        <MudNavLink Href="/catalogos/categorias-producto" Icon="@Icons.Material.Filled.TableRows">Categorías de producto</MudNavLink>
                        <MudNavLink Href="/catalogos/tipos-servicio" Icon="@Icons.Material.Filled.CleaningServices">Tipos de servicio</MudNavLink>
                        <MudNavLink Href="/catalogos/tecnicos" Icon="@Icons.Material.Filled.Person">Técnicos</MudNavLink>
                        <MudNavLink Href="/catalogos/activos-amortizables" Icon="@Icons.Material.Filled.Build">Activos amortizables</MudNavLink>
                        <MudNavLink Href="/catalogos/dosificacion" Icon="@Icons.Material.Filled.Notes">Dosificación</MudNavLink>
                        <MudNavLink Href="/catalogos/frecuencia" Icon="@Icons.Material.Filled.Schedule">Frecuencia</MudNavLink>
                        <MudNavLink Href="/catalogos/vehiculos" Icon="@Icons.Material.Filled.DirectionsCar">Vehículos</MudNavLink>
                        <MudNavLink Href="/catalogos/plagas" Icon="@Icons.Material.Filled.Block">Tipos de plaga</MudNavLink>
                        <MudNavLink Href="/catalogos/ubicaciones" Icon="@Icons.Material.Filled.Place">Lugares a tratar</MudNavLink>
                        <MudNavLink Href="/catalogos/metodos" Icon="@Icons.Material.Filled.Tune">Métodos de aplicación</MudNavLink>
                        <MudNavLink Href="/catalogos/equipos" Icon="@Icons.Material.Filled.Workspaces">Tipos de equipo</MudNavLink>
                        <MudNavLink Href="/catalogos/bodegas" Icon="@Icons.Material.Filled.Archive">Bodegas</MudNavLink>
                        <MudNavLink Href="/catalogos/locaciones" Icon="@Icons.Material.Filled.List">Locaciones</MudNavLink>
                        <MudNavLink Href="/catalogos/tipos-cambio" Icon="@Icons.Material.Filled.CurrencyExchange">Tipos de cambio</MudNavLink>
                    </MudNavGroup>
                }

                @* Operación: las capacidades que vienen del legacy (plantillas, visitas,
                   órdenes, requisas, inventario, reportes). Solo se agrega un link cuando la
                   página existe. Ningún catálogo se repite en este grupo: los catálogos viven
                   en "Catálogos" (D-21). *@
                @if (TienePermiso("PLANTILLAS.VER") || TienePermiso("VISITAS.VER") ||
                     TienePermiso("OT.VER") || TienePermiso("REQUISAS.VER") ||
                     TienePermiso("INVENTARIO.VER") || TienePermiso("REPORTES.VER"))
                {
                    <MudNavGroup Title="Operación" Icon="@Icons.Material.Filled.Build" Expanded="true">
                        @if (TienePermiso("PLANTILLAS.VER"))
                        {
                            <MudNavLink Href="/plantillas" Icon="@Icons.Material.Filled.Description">Plantillas</MudNavLink>
                        }
                        @if (TienePermiso("VISITAS.VER"))
                        {
                            <MudNavLink Href="/visitas" Icon="@Icons.Material.Filled.CalendarMonth">Visitas</MudNavLink>
                        }
                        @if (TienePermiso("OT.VER"))
                        {
                            <MudNavLink Href="/ordenes" Icon="@Icons.Material.Filled.Assignment">Órdenes de trabajo</MudNavLink>
                        }
                        @if (TienePermiso("REQUISAS.VER"))
                        {
                            <MudNavLink Href="/requisas" Icon="@Icons.Material.Filled.Inventory">Requisas</MudNavLink>
                        }
                        @if (TienePermiso("INVENTARIO.VER"))
                        {
                            <MudNavLink Href="/inventario/documentos" Icon="@Icons.Material.Filled.LocalShipping">Documentos de inventario</MudNavLink>
                        }
                        @if (TienePermiso("REPORTES.VER"))
                        {
                            <MudNavLink Href="/reportes" Icon="@Icons.Material.Filled.Print">Reportes</MudNavLink>
                        }
                    </MudNavGroup>
                }

                @* El grupo de administración se abre con cualquiera de sus permisos, como el de
                   catálogos: un auditor con AUDITORIA.VER y nada de ADMIN.* tiene que poder
                   llegar a su página, y no tendría por dónde si el grupo dependiera de ADMIN. *@
                @if (EsAdmin || TienePermiso("AUDITORIA.VER"))
                {
                    <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                        @if (TienePermiso("ADMIN.USUARIOS"))
                        {
                            <MudNavLink Href="/administracion/usuarios" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios</MudNavLink>
                        }
                        @if (TienePermiso("ADMIN.ROLES"))
                        {
                            <MudNavLink Href="/administracion/roles" Icon="@Icons.Material.Filled.Workspaces">Roles y permisos</MudNavLink>
                        }
                        @if (TienePermiso("ADMIN.PARAMETROS"))
                        {
                            <MudNavLink Href="/administracion/parametros" Icon="@Icons.Material.Filled.Tune">Parámetros</MudNavLink>
                        }
                        @if (TienePermiso("AUDITORIA.VER"))
                        {
                            <MudNavLink Href="/auditoria" Icon="@Icons.Material.Filled.HistoryEdu">Bitácora</MudNavLink>
                        }
                        <MudDivider Class="my-1" />
                        <MudNavLink Href="/cambiar-contrasena" Icon="@Icons.Material.Filled.Lock">Cambiar contraseña</MudNavLink>
                    </MudNavGroup>
                }
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [Parameter]
    public RenderFragment? Body { get; set; }

    [Parameter]
    public bool MostrarSidebar { get; set; } = true;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    [Inject]
    private HttpClient Http { get; set; } = null!;

    private MudTheme Tema { get; set; } = OrkinTheme.Crear();
    private int _noLeidas;
    private CancellationTokenSource? _cancelarSondeo;
    private Task? _sondeo;
    private bool _drawerAbierto = true;
    private string _nombreUsuario = string.Empty;
    private HashSet<string> _permisos = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Claims de permisos que el usuario tiene. El JWT los trae como claim "orkin:permiso".
    /// La denegación explícita ("orkin:permiso:no") pisa la concesión.
    /// </summary>
    private bool TienePermiso(string codigo)
        => _permisos.Contains(codigo) && !_permisos.Contains($"{codigo}__DENEGADO");

    private bool EsAdmin =>
        TienePermiso("ADMIN.USUARIOS") ||
        TienePermiso("ADMIN.ROLES") ||
        TienePermiso("ADMIN.PARAMETROS");

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        _nombreUsuario = estado.User.FindFirst("orkin:nombre")?.Value
            ?? estado.User.Identity?.Name
            ?? string.Empty;

        // Permisos concedidos
        _permisos = estado.User
            .FindAll("orkin:permiso")
            .Select(c => c.Value)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // Permisos denegados explícitamente: el claim "orkin:permiso:no" pisa al concedido
        var denegados = estado.User
            .FindAll("orkin:permiso:no")
            .Select(c => c.Value)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var d in denegados)
        {
            _permisos.Add($"{d}__DENEGADO");
        }

        if (TienePermiso("NOTIFICACIONES.VER"))
        {
            try
            {
                await CargarBandejaAsync();
            }
            catch (Exception)
            {
                // La campana es decorativa: si la API no responde al entrar, el usuario sigue
                // pudiendo trabajar. La página de notificaciones sí mostrará el error.
                _noLeidas = 0;
            }

            _cancelarSondeo = new CancellationTokenSource();
            _sondeo = SondearBandejaAsync(_cancelarSondeo.Token);
        }
    }

    /// <summary>
    /// Actualiza el contador cada minuto. Es una herramienta de fondo: si la API está caída no
    /// merece un snackbar cada vuelta, y menos en el layout, que se monta en todas las pantallas.
    /// </summary>
    private async Task SondearBandejaAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromMinutes(1), cancellationToken);
                await CargarBandejaAsync();
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                break;
            }
            catch (Exception)
            {
                // Se conserva el último contador: la bandeja completa sí avisa al abrirla.
            }
        }
    }

    private async Task CargarBandejaAsync()
    {
        var respuesta = await Http.GetFromJsonAsync<RespuestaBandeja>("api/notificaciones/bandeja");
        if (respuesta?.Exito == true && respuesta.Datos is not null)
        {
            _noLeidas = respuesta.Datos.NoLeidas;
        }
    }

    private void VerNotificaciones() => Navigation.NavigateTo("/notificaciones");

    private void ToggleDrawer() => _drawerAbierto = !_drawerAbierto;

    private void CerrarSesion() => Navigation.NavigateTo("/logout", forceLoad: false);

    public void Dispose()
    {
        _cancelarSondeo?.Cancel();
        _cancelarSondeo?.Dispose();
        _cancelarSondeo = null;
        _sondeo = null;
    }
}