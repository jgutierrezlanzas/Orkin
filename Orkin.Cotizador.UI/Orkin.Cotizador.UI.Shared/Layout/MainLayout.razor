<MudThemeProvider Theme="Tema" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (MostrarSidebar)
    {
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-3">ORKIN · Cotizador</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mr-3">@_nombreUsuario</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="CerrarSesion" aria-label="Cerrar sesión" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerAbierto" Elevation="2" ClipMode="DrawerClipMode.Always">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Color="Color.Primary">Cotizador</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/cotizaciones" Icon="@Icons.Material.Filled.RequestQuote">Cotizaciones</MudNavLink>
                <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
                <MudNavLink Href="/productos" Icon="@Icons.Material.Filled.Inventory">Productos</MudNavLink>
                <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.Settings">Administración</MudNavLink>
                <MudNavLink Href="/cambiar-contrasena" Icon="@Icons.Material.Filled.Lock">Cambiar contraseña</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [Parameter]
    public RenderFragment? Body { get; set; }

    [Parameter]
    public bool MostrarSidebar { get; set; } = true;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    private MudTheme Tema { get; set; } = OrkinTheme.Crear();
    private bool _drawerAbierto = true;
    private string _nombreUsuario = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        _nombreUsuario = estado.User.FindFirst("orkin:nombre")?.Value
            ?? estado.User.Identity?.Name
            ?? string.Empty;
    }

    private void ToggleDrawer() => _drawerAbierto = !_drawerAbierto;

    private void CerrarSesion() => Navigation.NavigateTo("/logout", forceLoad: false);
}
