@page "/administracion/parametros"
@attribute [Authorize("ADMIN.PARAMETROS")]
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminService AdminService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Parámetros generales</MudText>
    </div>

    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4" Variant="Variant.Outlined">
        Lo que se ajusta aquí afecta a la siguiente operación sin redeploy. El valor se valida
        contra el tipo declarado del parámetro, no contra lo que la pantalla deje pasar.
    </MudAlert>

    @* Los parámetros agrupados por su grupo: General, Cotización, Aprobación, PDF, Seguridad… *@
    @foreach (var grupo in _parametros.GroupBy(p => p.Grupo ?? "General"))
    {
        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-4 mb-2">@grupo.Key</MudText>
        <MudDivider Class="mb-2" />

        @foreach (var parametro in grupo)
        {
            <MudPaper Elevation="1" Class="pa-3 mb-2 d-flex align-center">
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2"><b>@parametro.Nombre</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@parametro.Descripcion</MudText>
                    @if (parametro.EsSecreto)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">secreto</MudChip>
                    }
                </div>
                <div class="text-end mr-4" style="min-width: 140px;">
                    <MudText Typo="Typo.body2"><code>@EsPorcentaje(parametro, parametro.Valor)</code></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@parametro.TipoDato</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(parametro))" />
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<ParametroModel> _parametros = [];
    private bool _cargando;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            _parametros = await AdminService.ListarParametrosAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>
    /// Los parámetros cuyo nombre lleva «MARGEN» son porcentajes: el administrador teclea 5.5
    /// y piensa en 5,5 %, no en 0.055. Si el nombre lo dice, se muestra con el signo.
    /// </summary>
    private static string EsPorcentaje(ParametroModel parametro, string? valor)
    {
        if (parametro.Nombre.Contains("MARGEN", StringComparison.OrdinalIgnoreCase) && valor is not null)
        {
            return $"{valor}%";
        }
        return valor ?? "—";
    }

    private async Task Editar(ParametroModel parametro)
    {
        var copia = new ParametroModel
        {
            Id = parametro.Id,
            Nombre = parametro.Nombre,
            Descripcion = parametro.Descripcion,
            Valor = parametro.Valor,
            TipoDato = parametro.TipoDato,
            Grupo = parametro.Grupo,
            Orden = parametro.Orden,
            EsSistema = parametro.EsSistema,
            EsSecreto = parametro.EsSecreto
        };

        var esPorcentaje = parametro.Nombre.Contains("MARGEN", StringComparison.OrdinalIgnoreCase);

        var parametros = new DialogParameters<ParametroDialogo>
        {
            { d => d.Modelo, copia },
            { d => d.EsPorcentaje, esPorcentaje }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<ParametroDialogo>(
            parametro.Nombre, parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not ParametroModel editado)
        {
            return;
        }

        var respuesta = await AdminService.ActualizarParametroAsync(editado);
        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Parámetro guardado.", Severity.Success);
            _parametros = await AdminService.ListarParametrosAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar el parámetro.", Severity.Error);
        }
    }
}
