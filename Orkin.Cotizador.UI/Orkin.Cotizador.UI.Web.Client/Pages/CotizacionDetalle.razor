@page "/cotizaciones/{Id:guid}"
@attribute [Authorize("COTIZACIONES.VER")]
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (_cargando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_cotizacion is null)
    {
        <MudAlert Severity="Severity.Warning">Cotización no encontrada.</MudAlert>
    }
    else
    {
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4" Color="Color.Primary">@_cotizacion.Numero</MudText>
            <MudChip T="string" Size="Size.Small" Color="@EstadoColor(_cotizacion.EstadoCodigo)">@_cotizacion.EstadoNombre</MudChip>
        </div>

        <MudPaper Elevation="2" Class="pa-4 mb-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption">Cliente</MudText>
                    <MudText Typo="Typo.body1">@_cotizacion.ClienteNombre</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption">Tipo de servicio</MudText>
                    <MudText Typo="Typo.body1">@_cotizacion.TipoServicioNombre</MudText>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.caption">Fecha</MudText>
                    <MudText Typo="Typo.body1">@_cotizacion.Fecha.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.caption">Margen</MudText>
                    <MudText Typo="Typo.body1">@((_cotizacion.Margen * 100).ToString("N1"))%</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="4" Class="pa-4 mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">Resultados</MudText>
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background: #FAFAFA; border-radius: 8px;">
                        <MudText Typo="Typo.caption">Total insumos</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Primary">@_cotizacion.TotalInsumos.ToString("N2")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background: #FAFAFA; border-radius: 8px;">
                        <MudText Typo="Typo.caption">Costo total</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Primary">@_cotizacion.CostoTotal.ToString("N2")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background: #FAFAFA; border-radius: 8px;">
                        <MudText Typo="Typo.caption">Precio C$</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success">@_cotizacion.PrecioCordobas.ToString("N2")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background: #FAFAFA; border-radius: 8px;">
                        <MudText Typo="Typo.caption">Precio US$</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success">@_cotizacion.PrecioUsd.ToString("N2")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.body2">TC: <b>@_cotizacion.TipoCambioValor.ToString("N4")</b> (@_cotizacion.TipoCambioFecha.ToString("dd/MM/yyyy"))</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.body2">Semestre 1: <b>@_cotizacion.TotalInsumosSemestre1.ToString("N2")</b></MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.body2">Semestre 2: <b>@_cotizacion.TotalInsumosSemestre2.ToString("N2")</b></MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.body2">Creada: <b>@_cotizacion.CreatedAt.ToString("dd/MM/yyyy HH:mm")</b></MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <div class="d-flex gap-2 mt-4">
            @if (PuedeAnular)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Block"
                           Disabled="_anulando" OnClick="Anular">
                    Anular
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("/cotizaciones"))">
                Volver al listado
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CotizacionListItem? _cotizacion;
    private bool _cargando;
    private bool _anulando;
    private bool _puedeAnular;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var respuesta = await Http.GetFromJsonAsync<ApiResponse<CotizacionListItem>>($"api/cotizaciones/{Id}");
            _cotizacion = respuesta?.Datos;

            // El botón de anular aparece solo para quien tiene el permiso y cuando la
            // cotización no está ya anulada (estado terminal) ni aprobada (para anular una
            // aprobada hay que hacer una nueva versión, no borrar la vigente).
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeAnular = estado.User.HasClaim("orkin:permiso", "COTIZACIONES.ANULAR");
        }
        finally
        {
            _cargando = false;
        }
    }

    private bool PuedeAnular => _puedeAnular && _cotizacion?.EstadoCodigo != "ANULADA" && _cotizacion?.EstadoCodigo != "APROBADA";
    private bool PuedeEditar => _cotizacion?.EstadoCodigo is "BORRADOR" or "RECHAZADA";
    private bool EsEditable => _cotizacion?.EstadoCodigo is "BORRADOR" or "RECHAZADA";

    /// <summary>
    /// Anular abre un diálogo que pide el motivo. Anular sin motivo es la puerta abierta a
    /// "se anuló por accidente" sin rastro de qué pasó.
    /// </summary>
    private async Task Anular()
    {
        var parametros = new DialogParameters<AnularCotizacionDialogo>
        {
            { d => d.Numero, _cotizacion?.Numero ?? "" }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<AnularCotizacionDialogo>("Anular cotización", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not string motivo)
        {
            return;
        }

        _anulando = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/cotizaciones/{Id}/anular", new { Motivo = motivo });
            var body = await response.Content.ReadFromJsonAsync<ApiResponse<CotizacionListItem>>();

            if (body?.Exito == true)
            {
                Snackbar.Add("Cotización anulada. La fila y su historial se conservan.", Severity.Success);
                Navigation.NavigateTo("/cotizaciones", forceLoad: true);
            }
            else
            {
                Snackbar.Add(body?.Mensaje ?? "No se pudo anular la cotización.", Severity.Error);
            }
        }
        finally
        {
            _anulando = false;
        }
    }

    private static Color EstadoColor(string codigo) => codigo switch
    {
        "BORRADOR" => Color.Warning,
        "ENVIADA" => Color.Info,
        "APROBADA" => Color.Success,
        "RECHAZADA" => Color.Error,
        "ANULADA" => Color.Default,
        _ => Color.Default
    };
}