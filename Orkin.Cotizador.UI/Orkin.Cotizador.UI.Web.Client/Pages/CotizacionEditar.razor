@page "/cotizaciones/editar/{Id:guid}"
@attribute [Authorize("COTIZACIONES.EDITAR")]
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject CotizacionService CotizacionService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* Pantalla de edición. El formulario es el mismo componente del alta, en modo edición: aquí
   solo se trae la cotización, se pasa al componente y se decide qué hacer al guardar.
   Lo que antes pasaba acá y ya no pasa:
     * un formulario reducido, sin amortizables ni modalidad ni técnico ni fechas ni dirección;
     * la fecha bloqueada con el motivo equivocado ("el consecutivo ya la lleva" — el
       consecutivo lleva número y año, no el día);
     * el guardado mandando modalidad nula y amortizables vacíos, que borraba lo que ya estaba.
   Todo eso ahora está en un solo sitio, y por eso las dos pantallas ya pueden volver a
   separarse sin que nadie lo note. *@

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (_cargando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_cotizacion is null)
    {
        <MudAlert Severity="Severity.Warning">Cotización no encontrada o sin permiso para editarla.</MudAlert>
    }
    else
    {
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4" Color="Color.Primary">Editar @_cotizacion.Numero</MudText>
            <MudChip T="string" Size="Size.Small" Color="@Color.Warning">Recalculada al guardar</MudChip>
        </div>

        <CotizacionFormulario Cotizacion="_cotizacion" OnGuardar="Guardar" OnCancelar="Cancelar" />
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CotizacionDetalleModel? _cotizacion;
    private bool _cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSet y no OnInitialized: esta pantalla es reentrante (si quien edita abre
        // otra cotización sin pasar por el listado, Blazor reutiliza la instancia y OnInitialized
        // no vuelve a correr). Con OnInitialized, editar A y luego editar B en la misma sesión
        // dejaría la pantalla mostrando A con el título de B.
        _cargando = true;
        try
        {
            _cotizacion = await CotizacionService.ObtenerDetalleAsync(Id);
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>
    /// Traduce el formulario a una llamada de actualización. El cliente no va: no se cambia, y
    /// mandarlo sería inviting a algo que la API no hace.
    /// </summary>
    private async Task Guardar(CotizacionFormularioDatos datos)
    {
        var numero = _cotizacion?.Numero;

        var respuesta = await CotizacionService.ActualizarAsync(
            Id,
            datos.TipoServicioId,
            datos.Fecha,
            datos.Margen,
            datos.Insumos,
            datos.Amortizables,
            datos.ModalidadCodigo,
            datos.TecnicoAsignadoId,
            datos.FechaEstimada,
            datos.DireccionServicio);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add($"{numero}: cambios guardados y recalculados.", Severity.Success);
            Navigation.NavigateTo($"/cotizaciones/{Id}");
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }

    private void Cancelar() => Navigation.NavigateTo($"/cotizaciones/{Id}");
}