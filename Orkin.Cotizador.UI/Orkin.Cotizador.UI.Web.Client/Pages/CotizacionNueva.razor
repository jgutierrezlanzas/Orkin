@page "/cotizaciones/nueva"
@attribute [Authorize("COTIZACIONES.CREAR")]
@layout MainLayout
@inject CotizacionService CotizacionService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* Pantalla de alta. Todo el formulario vive en <see cref="CotizacionFormulario"/>, que es el
   mismo componente que usa la edición: esta pantalla solo pone el título y decide qué hacer con
   los datos al guardar. Si mañana se le agrega un campo al formulario, aparece en las dos
   pantallas sin tocar ninguna de las dos — que es exactamente lo que no pasaba antes, cuando
   eran dos archivos y el de edición se quedó a medias. *@

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Nueva cotización</MudText>

    @* Sin Cotizacion = modo alta: el formulario arranca vacío. No hace falta una bandera de
       "cargando" propia porque el componente no tiene nada que traer de esta pantalla: carga
       sus catálogos y levanta él mismo. *@
    <CotizacionFormulario OnGuardar="Guardar" />
</MudContainer>

@code {
    /// <summary>
    /// Traduce el formulario a una llamada de alta. La única diferencia con la edición es el
    /// cliente: el alta lo elige (del catálogo o nuevo), y por eso es el único dato que aquí se
    /// pasa y allá no.
    /// </summary>
    private async Task Guardar(CotizacionFormularioDatos datos)
    {
        var respuesta = await CotizacionService.CrearAsync(
            datos.ClienteId,
            datos.ClienteNombre,
            datos.TipoClienteId,
            datos.TipoServicioId,
            datos.Fecha,
            datos.ModalidadCodigo,
            datos.Margen,
            datos.Insumos,
            datos.Amortizables,
            datos.TecnicoAsignadoId,
            datos.FechaEstimada,
            datos.DireccionServicio);

        if (respuesta?.Exito == true && respuesta.Datos is not null)
        {
            Snackbar.Add($"Cotización {respuesta.Datos.Numero} creada.", Severity.Success);
            Navigation.NavigateTo("/cotizaciones");
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}