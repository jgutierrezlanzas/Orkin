@page "/catalogos/tipos-servicio"
@attribute [Authorize("CATALOGOS.VER")]
@layout MainLayout
@inject CatalogoService CatalogoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Tipos de servicio</MudText>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Nuevo">Nuevo tipo de servicio</MudButton>
        }
    </div>

    <MudTable Items="_tipos" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>UM</MudTh>
            <MudTh>Residencial</MudTh>
            <MudTh>Empresarial</MudTh>
            <MudTh>Orden</MudTh>
            <MudTh>Activo</MudTh>
            @if (_puedeEditar)
            {
                <MudTh>Acciones</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
            <MudTd DataLabel="UM">@(context.UnidadMedidaNombre ?? "-")</MudTd>
            <MudTd DataLabel="Residencial">
                <MudIcon Icon="@(context.EsResidencialPorDefecto ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            <MudTd DataLabel="Empresarial">
                <MudIcon Icon="@(context.EsEmpresarialPorDefecto ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            <MudTd DataLabel="Orden">@context.Orden</MudTd>
            <MudTd DataLabel="Activo">
                <MudIcon Icon="@(context.EsActivo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            @if (_puedeEditar)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(context))" />
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<TipoServicioModel> _tipos = [];
    private List<UnidadMedidaModel> _unidades = [];
    private bool _cargando;
    private bool _puedeEditar;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeEditar = estado.User.HasClaim("orkin:permiso", "CATALOGOS.EDITAR");
            _unidades = await CatalogoService.ListarUnidadesMedidaAsync();
            _tipos = await CatalogoService.ListarTiposServicioAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task Nuevo() => AbrirDialogo(new TipoServicioModel());

    private Task Editar(TipoServicioModel tipo) => AbrirDialogo(new TipoServicioModel
    {
        Id = tipo.Id,
        Codigo = tipo.Codigo,
        Nombre = tipo.Nombre,
        Descripcion = tipo.Descripcion,
        UnidadMedidaId = tipo.UnidadMedidaId,
        EsResidencialPorDefecto = tipo.EsResidencialPorDefecto,
        EsEmpresarialPorDefecto = tipo.EsEmpresarialPorDefecto,
        Orden = tipo.Orden,
        EsActivo = tipo.EsActivo
    });

    private async Task AbrirDialogo(TipoServicioModel modelo)
    {
        var nombreUnidad = modelo.Id == Guid.Empty
            ? null
            : _tipos.FirstOrDefault(t => t.Id == modelo.Id)?.UnidadMedidaNombre;

        var parametros = new DialogParameters<TipoServicioDialogo>
        {
            { d => d.Modelo, modelo },
            { d => d.Unidades, _unidades },
            { d => d.NombreUnidadActual, nombreUnidad }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<TipoServicioDialogo>(
            modelo.Id == Guid.Empty ? "Nuevo tipo de servicio" : $"Editar — {modelo.Nombre}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not TipoServicioModel editado)
        {
            return;
        }

        var respuesta = modelo.Id == Guid.Empty
            ? await CatalogoService.CrearTipoServicioAsync(editado)
            : await CatalogoService.ActualizarTipoServicioAsync(editado);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Guardado correctamente.", Severity.Success);
            _tipos = await CatalogoService.ListarTiposServicioAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}
