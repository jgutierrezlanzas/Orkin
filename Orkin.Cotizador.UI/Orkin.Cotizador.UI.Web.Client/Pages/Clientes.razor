@page "/clientes"
@attribute [Authorize("CLIENTES.VER")]
@layout MainLayout
@inject CatalogoService CatalogoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Clientes</MudText>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Nuevo">Nuevo cliente</MudButton>
        }
    </div>

    <MudTable Items="_clientes" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Correo</MudTh>
            <MudTh>Ciudad</MudTh>
            <MudTh>Activo</MudTh>
            @if (_puedeEditar)
            {
                <MudTh>Acciones</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Tipo">@(context.TipoClienteNombre ?? "-")</MudTd>
            <MudTd DataLabel="Teléfono">@(context.Telefono ?? "-")</MudTd>
            <MudTd DataLabel="Correo">@(context.Correo ?? "-")</MudTd>
            <MudTd DataLabel="Ciudad">@(context.Ciudad ?? "-")</MudTd>
            <MudTd DataLabel="Activo">
                <MudIcon Icon="@(context.EsActivo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            @if (_puedeEditar)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(context))" />
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<ClienteModel> _clientes = [];
    private List<TipoClienteOption> _tiposCliente = [];
    private bool _cargando;
    private bool _puedeEditar;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeEditar = estado.User.HasClaim("orkin:permiso", "CLIENTES.CREAR") || estado.User.HasClaim("orkin:permiso", "CLIENTES.EDITAR");
            _tiposCliente = await CatalogoService.ObtenerTiposClienteAsync();
            _clientes = await CatalogoService.ListarClientesAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task Nuevo() => AbrirDialogo(ModeloNuevo());

    private Task Editar(ClienteModel cliente) => AbrirDialogo(new ClienteModel
    {
        Id = cliente.Id,
        Codigo = cliente.Codigo,
        Nombre = cliente.Nombre,
        RazonSocial = cliente.RazonSocial,
        TipoClienteId = cliente.TipoClienteId,
        CedulaORuc = cliente.CedulaORuc,
        IdentificacionFiscal = cliente.IdentificacionFiscal,
        Direccion = cliente.Direccion,
        Ciudad = cliente.Ciudad,
        Departamento = cliente.Departamento,
        Telefono = cliente.Telefono,
        Correo = cliente.Correo,
        ContactoNombre = cliente.ContactoNombre,
        ContactoCargo = cliente.ContactoCargo,
        SitioWeb = cliente.SitioWeb,
        Notas = cliente.Notas,
        EsActivo = cliente.EsActivo
    });

    /// <summary>El modelo de un alta, con el primer tipo de cliente ya elegido para no obligar a abrir el combo.</summary>
    private ClienteModel ModeloNuevo()
        => new()
        {
            TipoClienteId = _tiposCliente.Count > 0 ? _tiposCliente[0].Id : (byte)0
        };

    private async Task AbrirDialogo(ClienteModel modelo)
    {
        var nombreTipo = modelo.Id == Guid.Empty
            ? null
            : _clientes.FirstOrDefault(c => c.Id == modelo.Id)?.TipoClienteNombre;

        var parametros = new DialogParameters<ClienteDialogo>
        {
            { d => d.Modelo, modelo },
            { d => d.TiposCliente, _tiposCliente },
            { d => d.NombreTipoClienteActual, nombreTipo }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<ClienteDialogo>(
            modelo.Id == Guid.Empty ? "Nuevo cliente" : $"Editar — {modelo.Nombre}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not ClienteModel editado)
        {
            return;
        }

        var esAlta = modelo.Id == Guid.Empty;
        var respuesta = esAlta
            ? await CatalogoService.CrearClienteAsync(editado)
            : await CatalogoService.ActualizarClienteAsync(editado);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Guardado correctamente.", Severity.Success);
            _clientes = await CatalogoService.ListarClientesAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}
