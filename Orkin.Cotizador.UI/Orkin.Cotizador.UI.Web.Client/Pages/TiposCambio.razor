@page "/catalogos/tipos-cambio"
@attribute [Authorize("CATALOGOS.VER")]
@layout MainLayout
@inject CatalogoService CatalogoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Tipos de cambio</MudText>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Nuevo">Nuevo tipo de cambio</MudButton>
        }
    </div>

    <MudTable Items="_tiposCambio" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Valor (C$/US$)</MudTh>
            <MudTh>Fuente</MudTh>
            <MudTh>Activo</MudTh>
            @if (_puedeEditar)
            {
                <MudTh>Acciones</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Fecha.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Valor">@context.Valor.ToString("N4")</MudTd>
            <MudTd DataLabel="Fuente">@(context.FuenteNombre ?? "-")</MudTd>
            <MudTd DataLabel="Activo">
                <MudIcon Icon="@(context.EsActivo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            @if (_puedeEditar)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(context))" />
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<TipoCambioModel> _tiposCambio = [];
    private List<FuenteTipoCambioOption> _fuentes = [];
    private bool _cargando;
    private bool _puedeEditar;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeEditar = estado.User.HasClaim("orkin:permiso", "CATALOGOS.EDITAR");
            _fuentes = await CatalogoService.ObtenerFuentesTipoCambioAsync();
            _tiposCambio = await CatalogoService.ListarTiposCambioAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task Nuevo() => AbrirDialogo(new TipoCambioModel
    {
        Fecha = DateOnly.FromDateTime(DateTime.Today),
        FuenteId = _fuentes.Count > 0 ? _fuentes[0].Id : (byte)0
    });

    private Task Editar(TipoCambioModel tc) => AbrirDialogo(new TipoCambioModel
    {
        Id = tc.Id,
        Fecha = tc.Fecha,
        Valor = tc.Valor,
        FuenteId = tc.FuenteId,
        EsActivo = tc.EsActivo
    });

    private async Task AbrirDialogo(TipoCambioModel modelo)
    {
        var nombreFuente = modelo.Id == Guid.Empty
            ? null
            : _tiposCambio.FirstOrDefault(t => t.Id == modelo.Id)?.FuenteNombre;

        var parametros = new DialogParameters<TipoCambioDialogo>
        {
            { d => d.Modelo, modelo },
            { d => d.Fuentes, _fuentes },
            { d => d.NombreFuenteActual, nombreFuente }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<TipoCambioDialogo>(
            modelo.Id == Guid.Empty ? "Nuevo tipo de cambio" : $"Editar — {modelo.Fecha:yyyy-MM-dd}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not TipoCambioModel editado)
        {
            return;
        }

        var respuesta = modelo.Id == Guid.Empty
            ? await CatalogoService.CrearTipoCambioAsync(editado)
            : await CatalogoService.ActualizarTipoCambioAsync(editado);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Guardado correctamente.", Severity.Success);
            _tiposCambio = await CatalogoService.ListarTiposCambioAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}
