@page "/catalogos/categorias-producto"
@attribute [Authorize("CATALOGOS.VER")]
@layout MainLayout
@inject CatalogoService CatalogoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Categorías de producto</MudText>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Nuevo">Nueva categoría</MudButton>
        }
    </div>

    <MudTable Items="_categorias" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Orden</MudTh>
            <MudTh>Activo</MudTh>
            @if (_puedeEditar)
            {
                <MudTh>Acciones</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
            <MudTd DataLabel="Orden">@context.Orden</MudTd>
            <MudTd DataLabel="Activo">
                <MudIcon Icon="@(context.EsActivo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            @if (_puedeEditar)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(context))" />
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<CategoriaProductoModel> _categorias = [];
    private bool _cargando;
    private bool _puedeEditar;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeEditar = estado.User.HasClaim("orkin:permiso", "CATALOGOS.EDITAR");
            _categorias = await CatalogoService.ListarCategoriasProductoAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task Nuevo() => AbrirDialogo(new CategoriaProductoModel());

    private Task Editar(CategoriaProductoModel categoria) => AbrirDialogo(new CategoriaProductoModel
    {
        Id = categoria.Id,
        Codigo = categoria.Codigo,
        Nombre = categoria.Nombre,
        Descripcion = categoria.Descripcion,
        Orden = categoria.Orden,
        EsActivo = categoria.EsActivo
    });

    private async Task AbrirDialogo(CategoriaProductoModel modelo)
    {
        var parametros = new DialogParameters<CategoriaProductoDialogo>
        {
            { d => d.Modelo, modelo }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<CategoriaProductoDialogo>(
            modelo.Id == Guid.Empty ? "Nueva categoría" : $"Editar — {modelo.Nombre}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not CategoriaProductoModel editado)
        {
            return;
        }

        var respuesta = modelo.Id == Guid.Empty
            ? await CatalogoService.CrearCategoriaProductoAsync(editado)
            : await CatalogoService.ActualizarCategoriaProductoAsync(editado);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Guardado correctamente.", Severity.Success);
            _categorias = await CatalogoService.ListarCategoriasProductoAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}
