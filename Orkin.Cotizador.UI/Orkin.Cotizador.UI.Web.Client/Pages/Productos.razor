@page "/catalogos/productos"
@attribute [Authorize("CATALOGOS.VER")]
@layout MainLayout
@inject CatalogoService CatalogoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Productos</MudText>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Nuevo">Nuevo producto</MudButton>
        }
    </div>

    <MudTable Items="_productos" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>UM</MudTh>
            <MudTh>Costo</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Vida útil</MudTh>
            <MudTh>Activo</MudTh>
            @if (_puedeEditar)
            {
                <MudTh>Acciones</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Categoría">@(context.CategoriaNombre ?? "-")</MudTd>
            <MudTd DataLabel="UM">@(context.UnidadMedidaAbreviatura ?? "-")</MudTd>
            <MudTd DataLabel="Costo">@context.CostoActual.ToString("N2")</MudTd>
            <MudTd DataLabel="Precio">@context.PrecioVentaActual.ToString("N2")</MudTd>
            <MudTd DataLabel="Vida útil">@(context.VidaUtilMeses?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Activo">
                <MudIcon Icon="@(context.EsActivo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" />
            </MudTd>
            @if (_puedeEditar)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Editar(context))" />
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<ProductoModel> _productos = [];
    private List<CategoriaProductoModel> _categorias = [];
    private List<UnidadMedidaModel> _unidades = [];
    private bool _cargando;
    private bool _puedeEditar;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();
            _puedeEditar = estado.User.HasClaim("orkin:permiso", "CATALOGOS.EDITAR");
            _categorias = await CatalogoService.ListarCategoriasProductoAsync();
            _unidades = await CatalogoService.ListarUnidadesMedidaAsync();
            _productos = await CatalogoService.ListarProductosAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task Nuevo() => AbrirDialogo(ModeloNuevo());

    private Task Editar(ProductoModel producto) => AbrirDialogo(new ProductoModel
    {
        Id = producto.Id,
        Codigo = producto.Codigo,
        Nombre = producto.Nombre,
        Descripcion = producto.Descripcion,
        CategoriaId = producto.CategoriaId,
        UnidadMedidaId = producto.UnidadMedidaId,
        CostoActual = producto.CostoActual,
        PrecioVentaActual = producto.PrecioVentaActual,
        VidaUtilMeses = producto.VidaUtilMeses,
        EsActivo = producto.EsActivo
    });

    /// <summary>El modelo de un alta, con la unidad por defecto ya elegida para no obligar a abrir el combo.</summary>
    private ProductoModel ModeloNuevo()
        => new()
        {
            UnidadMedidaId = _unidades.Count > 0 ? _unidades[0].Id : Guid.Empty
        };

    private async Task AbrirDialogo(ProductoModel modelo)
    {
        var nombreCategoria = modelo.Id == Guid.Empty ? null : _productos.FirstOrDefault(p => p.Id == modelo.Id)?.CategoriaNombre;
        var producto = modelo.Id == Guid.Empty ? null : _productos.FirstOrDefault(p => p.Id == modelo.Id);
        var nombreUnidad = producto is null ? null
            : producto.UnidadMedidaNombre is null ? producto.UnidadMedidaAbreviatura
            : $"{producto.UnidadMedidaNombre} ({producto.UnidadMedidaAbreviatura})";

        var parametros = new DialogParameters<ProductoDialogo>
        {
            { d => d.Modelo, modelo },
            { d => d.Categorias, _categorias },
            { d => d.Unidades, _unidades },
            { d => d.NombreCategoriaActual, nombreCategoria },
            { d => d.NombreUnidadActual, nombreUnidad }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<ProductoDialogo>(
            modelo.Id == Guid.Empty ? "Nuevo producto" : $"Editar — {modelo.Nombre}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not ProductoModel editado)
        {
            return;
        }

        var respuesta = modelo.Id == Guid.Empty
            ? await CatalogoService.CrearProductoAsync(editado)
            : await CatalogoService.ActualizarProductoAsync(editado);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add("Guardado correctamente.", Severity.Success);
            _productos = await CatalogoService.ListarProductosAsync();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar.", Severity.Error);
        }
    }
}
