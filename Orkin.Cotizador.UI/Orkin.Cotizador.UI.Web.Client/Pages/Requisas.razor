@page "/requisas"
@attribute [Authorize("REQUISAS.VER")]
@layout MainLayout
@inject RequisaService ServicioRequisas
@inject ReportesService ServicioReportes
@inject OrdenService ServicioOrdenes
@inject CatalogoService Catalogos
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary">Requisas</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Operación · Requisa, Requisa_Detalle y Requisa_Tecnicos (SINCOERPORKIN)
            </MudText>
        </div>
        @if (_puedeEditar)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NuevaDesdeOrden">Nueva desde orden</MudButton>
        }
    </div>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Outlined="true">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">En el filtro</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@_requisas.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Outlined="true">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Generadas (GE)</MudText>
                <MudText Typo="Typo.h5" Color="Color.Info">@_requisas.Count(r => r.Estado == "GE")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Outlined="true">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Aprobadas (AP)</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@_requisas.Count(r => r.Estado == "AP")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Outlined="true">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Anuladas (AN)</MudText>
                <MudText Typo="Typo.h5" Color="Color.Error">@_requisas.Count(r => r.Estado == "AN")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Outlined="true">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_texto" Label="Requisa, orden, cliente o instrucción" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string?" @bind-Value="_cliente" Label="Cliente" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var cliente in _clientes)
                    {
                        <MudSelectItem T="string?" Value="@cliente.Codigo">@cliente.Nombre (@cliente.Codigo)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string?" @bind-Value="_estado" Label="Estado" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string?" Value="@("GE")">Generada (GE)</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("AP")">Aprobada (AP)</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("AN")">Anulada (AN)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="1">
                <MudDatePicker Date="@DesdeDateTime" DateChanged="@((DateTime? v) => DesdeDateTime = v)"
                               Label="Desde" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="1">
                <MudDatePicker Date="@HastaDateTime" DateChanged="@((DateTime? v) => HastaDateTime = v)"
                               Label="Hasta" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                           OnClick="Cargar">Buscar</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="_requisas" Loading="_cargando" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
              RowClassFunc="@((r, i) => r.Estado == "AN" ? "mud-text-secondary" : string.Empty)">
        <HeaderContent>
            <MudTh>Requisa / orden</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Locación</MudTh>
            <MudTh>Bodega</MudTh>
            <MudTh>Fechas</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Líneas</MudTh>
            <MudTh>Técnicos</MudTh>
            <MudTh>Instrucciones</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Requisa / orden">
                <MudText Typo="Typo.body2">@context.RequisaNumero</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Orden @context.OrdenNumero</MudText>
            </MudTd>
            <MudTd DataLabel="Cliente">
                <MudText Typo="Typo.body2">@context.ClienteNombre</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Cliente</MudText>
            </MudTd>
            <MudTd DataLabel="Locación">
                <MudText Typo="Typo.body2">@context.LocacionNombre</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Locacion</MudText>
            </MudTd>
            <MudTd DataLabel="Bodega">@context.Bodega</MudTd>
            <MudTd DataLabel="Fechas">
                <MudText Typo="Typo.body2">Requisa @context.FechaRequisa.ToString("dd/MM/yyyy")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Orden @context.FechaOrden?.ToString("dd/MM/yyyy")</MudText>
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Estado)">
                    @EstadoTexto(context.Estado)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Líneas">@context.Lineas</MudTd>
            <MudTd DataLabel="Técnicos">@context.Tecnicos</MudTd>
            <MudTd DataLabel="Instrucciones">@context.Instrucciones</MudTd>
            <MudTd>
                @if (_puedeEditar && context.Estado == "GE")
                {
                    <MudTooltip Text="Editar cabecera, líneas y técnicos (solo en GE)">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => Editar(context))" aria-label="Editar" />
                    </MudTooltip>
                }
                @if (_puedeAnular && context.Estado != "AN")
                {
                    <MudTooltip Text="Anular requisa desde su orden (SP legacy)">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Anular(context))" aria-label="Anular" />
                    </MudTooltip>
                }
                @if (_puedeImprimir)
                {
                    <MudTooltip Text="Imprime la requisa con SINCO_IMPRIMIR_REQUISAS sobre su fecha; el SP legacy filtra por rango y la API acota el PDF a esta requisa.">
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Info"
                                       OnClick="@(() => Imprimir(context))" aria-label="Imprimir requisa" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">No hay requisas para el filtro indicado.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<RequisaModel> _requisas = [];
    private List<ClienteModel> _clientes = [];
    private string? _texto;
    private string? _cliente;
    private string? _estado;
    private DateOnly? _desde;
    private DateOnly? _hasta;
    private bool _cargando;
    private bool _puedeEditar;
    private bool _puedeAnular;
    private bool _puedeImprimir;

    private DateTime? DesdeDateTime
    {
        get => _desde?.ToDateTime(TimeOnly.MinValue);
        set => _desde = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    private DateTime? HastaDateTime
    {
        get => _hasta?.ToDateTime(TimeOnly.MinValue);
        set => _hasta = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        _puedeEditar = estado.User.HasClaim("orkin:permiso", "REQUISAS.EDITAR");
        _puedeAnular = estado.User.HasClaim("orkin:permiso", "REQUISAS.ANULAR");
        _puedeImprimir = estado.User.HasClaim("orkin:permiso", "REQUISAS.IMPRIMIR");

        _clientes = await Catalogos.ListarClientesAsync();
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        try
        {
            _requisas = await ServicioRequisas.ListarAsync(_texto, _cliente, _estado, _desde, _hasta);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudieron cargar las requisas: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task NuevaDesdeOrden()
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var seleccion = await DialogService.ShowAsync<NuevaRequisaDialogo>(
            "Nueva requisa desde orden", options: opciones);
        var resultado = await seleccion.Result;

        if (resultado.Canceled || resultado.Data is not OrdenModel orden)
        {
            return;
        }

        var confirmacion = await DialogService.ShowAsync<ConfirmarDialogo>(
            "Generar requisa", new DialogParameters<ConfirmarDialogo>
            {
                { d => d.Titulo, $"Generar la requisa de la orden {orden.OrdenNumero}" },
                { d => d.Mensaje, "Se invoca SINCO_GENERA_REQUISA. La requisa toma el número de la orden y la orden pasa a AP; no se duplica la lógica de la Fase 4." }
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var aceptado = await confirmacion.Result;
        if (aceptado.Canceled || aceptado.Data is not true)
        {
            return;
        }

        try
        {
            var requisa = await ServicioRequisas.CrearDesdeOrdenAsync(orden);
            Snackbar.Add($"Requisa {requisa.RequisaNumero} generada desde la orden {orden.OrdenNumero}.", Severity.Success);
            await Cargar();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// El SP legacy de requisas no acepta número de requisa, solo rango de fechas: se le pasa la
    /// fecha de la fila y la API acota el dataset al número pedido antes de generar el PDF.
    /// </summary>
    private async Task Imprimir(RequisaModel requisa)
    {
        try
        {
            await ServicioReportes.ImprimirRequisaAsync(requisa.RequisaNumero, requisa.FechaRequisa);
            Snackbar.Add($"PDF de la requisa {requisa.RequisaNumero} generado.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Editar(RequisaModel requisa)
    {
        try
        {
            var completa = await ServicioRequisas.ObtenerAsync(requisa.RequisaNumero);
            if (completa is null)
            {
                Snackbar.Add("La requisa ya no existe en el ERP.", Severity.Warning);
                return;
            }

            await AbrirDialogo(completa);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo abrir la requisa: {ex.Message}", Severity.Error);
        }
    }

    private async Task AbrirDialogo(RequisaModel modelo)
    {
        var parametros = new DialogParameters<RequisaDialogo>
        {
            { d => d.Modelo, modelo }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<RequisaDialogo>(
            $"Requisa {modelo.RequisaNumero} · orden {modelo.OrdenNumero}", parametros, opciones);
        var resultado = await dialogo.Result;

        if (resultado.Canceled || resultado.Data is not RequisaModel editada)
        {
            return;
        }

        try
        {
            await ServicioRequisas.GuardarAsync(editada);
            Snackbar.Add("Requisa actualizada correctamente.", Severity.Success);
            await Cargar();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Anular(RequisaModel requisa)
    {
        var dialogo = await DialogService.ShowAsync<ConfirmarDialogo>(
            "Anular requisa", new DialogParameters<ConfirmarDialogo>
            {
                { d => d.Titulo, $"Anular la requisa {requisa.RequisaNumero}" },
                { d => d.Mensaje, "Se invoca SINCO_ANULAR_ORDENES_DE_TRABAJO desde la orden relacionada. La orden y la requisa pasan a AN; no se borra ninguna fila." }
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not true)
        {
            return;
        }

        try
        {
            await ServicioRequisas.AnularAsync(requisa);
            Snackbar.Add($"Requisa {requisa.RequisaNumero} anulada.", Severity.Success);
            await Cargar();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Color ColorEstado(string? estado) => estado switch
    {
        "GE" => Color.Info,
        "AP" => Color.Success,
        "AN" => Color.Error,
        _ => Color.Default
    };

    private static string EstadoTexto(string? estado) => estado switch
    {
        "GE" => "Generada",
        "AP" => "Aprobada",
        "AN" => "Anulada",
        _ => estado ?? "—"
    };
}
