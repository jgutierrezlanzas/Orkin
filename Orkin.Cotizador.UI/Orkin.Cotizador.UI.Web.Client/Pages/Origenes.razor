    /// <summary>
    /// Fecha en formato local legible, o un guion. La bitácora guarda UTC porque es la única
    /// forma de comparar corridas de clientes en zonas horarias distintas; mostrarla en UTC en
    /// pantalla haría que dos corridas parecieran descolocadas cuando no lo están.
    /// </summary>
    private static string Fecha(DateTime? utc) =>
        utc is null ? "—" : utc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

    /// <summary>Un intervalo en palabras. La lista de intervalos vive en ProgramacionDialogo.</summary>
    private static string TextoIntervalo(int segundos) => ProgramacionDialogo.TextoIntervalo(segundos);

    /// <summary>
    /// Cuánto falta para la próxima corrida, en palabras. Se redondea al segundo porque a menos
    /// de eso el número cambia entre un repintado y el siguiente y parece un contador roto.
    /// </summary>
    private static string CuentaRegresiva(DateTime proximaUtc)
    {
        var segundos = (proximaUtc.ToLocalTime() - DateTime.Now).TotalSeconds;

        if (segundos <= 0)
        {
            return "ahora";
        }

        if (segundos < 60)
        {
            return $"{(int)Math.Ceiling(segundos)} s";
        }

        if (segundos < 3600)
        {
            return $"{(int)Math.Ceiling(segundos / 60)} min";
        }

        return segundos < 86400
            ? $"{(int)Math.Ceiling(segundos / 3600)} h"
            : $"{(int)Math.Ceiling(segundos / 86400)} d";
    }

    /// <summary>
    /// Cuántas columnas trae el mapeo guardado, o null si el flujo no tiene mapeo. Va como
    /// número y no como «con mapeo» porque un mapeo de 20 columnas en una vista que ya se llama
    /// bien no es lo mismo que uno de 2, y quien mira la tabla quiere saber cuánto revisar si
    /// el ERP cambia.
    /// </summary>
    private static int? ConteoColumnas(string? mapeoJson)
    {
        if (string.IsNullOrWhiteSpace(mapeoJson))
        {
            return null;
        }

        try
        {
            var mapa = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(mapeoJson);
            return mapa?.Count;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private async Task EditarProgramacion(ErpFlujoModel flujo)
    {
        var parametros = new DialogParameters<ProgramacionDialogo>
        {
            { d => d.Flujo, flujo }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<ProgramacionDialogo>(
            $"Sincronización automática — {flujo.Nombre}", parametros, opciones);

        var resultado = await dialogo.Result;
        if (resultado.Canceled || resultado.Data is not ResultadoProgramacion programacion)
        {
            return;
        }

        var respuesta = await IntegracionService.ConfigurarProgramacionAsync(
            flujo.Id,
            programacion.TipoDisparador,
            programacion.IntervaloSegundos,
            programacion.MaximoRegistrosPorCorrida,
            programacion.MaximoFallosConsecutivos);

        if (respuesta?.Exito == true)
        {
            Snackbar.Add(
                programacion.TipoDisparador == "PROGRAMADO"
                    ? $"{flujo.Nombre}: se sincronizará cada {TextoIntervalo(programacion.IntervaloSegundos!.Value)}."
                    : $"{flujo.Nombre}: vuelve a sincronizarse solo cuando se le pida.",
                Severity.Success);
            await Recargar();
        }
        else
        {
            Snackbar.Add(respuesta?.Mensaje ?? "No se pudo guardar la programación.", Severity.Error);
        }
    }

