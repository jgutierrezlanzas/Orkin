@page "/login"
@layout LoginLayout
@inject AuthService AuthService
@inject CustomAuthStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@* El aviso de sesión expirada aparece cuando el FalloTransporteHandler detectó un 401 y
   redirigió acá. La sesión murió y quien estaba trabajando debe saber por qué lo sacaron,
   no adivinarlo. *@
@if (_sesionExpirada)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4" Variant="Variant.Outlined">
        Su sesión ha expirado. Vuelva a ingresar para continuar.
    </MudAlert>
}

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center" Style="height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%; max-width: 420px;">
        <div class="d-flex justify-center mb-6">
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">ORKIN</MudText>
        </div>

        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-6">
            Ingrese con su cuenta de ORKIN
        </MudText>

        <EditForm Model="_modelo" OnValidSubmit="Ingresar">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_modelo.Credencial"
                          Label="Correo o usuario"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          For="@(() => _modelo.Credencial)"
                          Class="mb-4" />

            @* El ojo muestra y esconde la contraseña. Va como adorno final y clickeable:
               un campo de contraseña sin forma de ver lo que se tecleó castiga al que
               escribe en un teclado ajeno, y el 80 % de los "no puedo entrar" es una
               mayúscula o un bloqueo de mayúsculas que este ojo habría mostrado. *@
            <MudTextField @bind-Value="_modelo.Contrasena"
                          @ref="_passwordInput"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          InputType="@(_verContrasena ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_verContrasena ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="@(_verContrasena ? "Esconder la contraseña" : "Mostrar la contraseña")"
                          OnAdornmentClick="@(() => _verContrasena = !_verContrasena)"
                          For="@(() => _modelo.Contrasena)"
                          Class="mb-4" />

            @* «Recordarme» decide dónde vive el token, no cuánto dura: marcado, la sesión
               sobrevive al cierre del navegador (localStorage); sin marcar, muere con la
               pestaña (sessionStorage). En una computadora compartida, sin marcar es lo
               que corresponde, y el texto de ayuda lo dice. *@
            <MudCheckBox T="bool" @bind-Value="_modelo.Recordar" Class="mb-2"
                         Label="Recordarme en este equipo" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-4">
                Marcado: la sesión sigue abierta aunque cierre el navegador. Sin marcar: la
                sesión termina al cerrar esta pestaña.
            </MudText>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_cargando">
                @if (_cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Ingresando...</MudText>
                }
                else
                {
                    <MudText>Ingresar</MudText>
                }
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequest _modelo = new();
    private bool _cargando;
    private bool _verContrasena;
    private bool _sesionExpirada;
    private MudTextField<string>? _passwordInput;

    protected override void OnInitialized()
    {
        // Cuando el FalloTransporteHandler detecta un 401 (token expirado), redirige a
        // /login?expirada=1. Aquí se lee la bandera para mostrar el aviso y que quien
        // estaba trabajando sepa por qué lo sacaron, en vez de adivinar.
        _sesionExpirada = Navigation.Uri.Contains("expirada=1", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Si quien entra marcó «Recordarme» la última vez, su correo ya está guardado: solo
        // falta la clave. Sin esto, volver a entrar tras una sesión expirada obligaba a
        // re-teclear el correo que ya se sabía — el fastidio exacto que «Recordarme» promete
        // ahorrar.
        var credencial = await AuthService.LeerCredencialRecordadaAsync();
        if (!string.IsNullOrWhiteSpace(credencial))
        {
            _modelo.Credencial = credencial;
            // El foco va en la clave, que es lo único que falta.
            await EnfocarPasswordAsync();
            StateHasChanged();
        }
    }

    private async Task EnfocarPasswordAsync()
    {
        try
        {
            var campo = _passwordInput?.ElementReference;
            if (campo.Id is not null)
            {
                await campo.FocusAsync();
            }
        }
        catch
        {
            // Si el foco falla (el campo aún no está pintado), no pasa nada: la credencial
            // ya está pre-llena y quien entra puede hacer clic.
        }
    }

    private async Task Ingresar()
    {
        _cargando = true;
        try
        {
            var respuesta = await AuthService.LoginAsync(_modelo);

            if (respuesta?.Exito == true && respuesta.Datos is not null)
            {
                // Guardar o borrar la credencial recordada. Si «Recordarme» está marcado, la
                // próxima vez que la sesión expire solo faltará la clave; sin él, ni el correo
                // queda — quien no lo marcó pidió explícitamente que la sesión muriera con la pestaña.
                await AuthService.GuardarCredencialRecordadaAsync(_modelo.Credencial, _modelo.Recordar);

                await AuthState.MarkUserAsAuthenticated(respuesta.Datos.Token, _modelo.Recordar);
                Navigation.NavigateTo("/");
            }
            else
            {
                Snackbar.Add(respuesta?.Mensaje ?? "No se pudo iniciar sesión.", Severity.Error);
            }
        }
        finally
        {
            _cargando = false;
        }
    }
}
