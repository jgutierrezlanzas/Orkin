@* Combo de catálogo que busca mientras se escribe y no puede mostrar un identificador crudo.

   Regla de la casa: si el dato se llama por su id (un Guid, un byte), a la pantalla llega su
   nombre o su descripción, nunca el identificador. Un combo que enseña "321b0838-7066-..." no
   dice nada de qué se está eligiendo y se ve espantoso.

   Regla de uso: los catálogos crecen. Un desplegable de 111 productos obliga a leerlos todos;
   con mil, es un pozo de scroll. Por esto el componente es un MudAutocomplete y no un
   MudSelect: escribir "aceite" y ver los tres aceites es la diferencia entre elegir y buscar.

   Cómo se garantiza que nunca sale un identificador: el texto cerrado sale de
   <see cref="TextoDelValor"/> — que resuelve el valor contra la lista y, si el valor ya no está
   (la categoría se desactivó y el filtro de activos la sacó), contra
   <see cref="TextoValorActual"/> del registro que se edita, o un guión como última instancia.
   Los resultados de búsqueda también salen de la lista: no hay rama que renderice un id.
*@
@using System.Linq.Expressions
@using System.Globalization
@using System.Text
@typeparam TItem
@typeparam TValue

<MudAutocomplete T="TValue"
                 Value="Value"
                 ValueChanged="OnCambio"
                 ValueExpression="ValueExpression"
                 SearchFunc="BuscarAsync"
                 ToStringFunc="TextoDelValor"
                 Label="@Label"
                 Variant="Variant"
                 Margin="Margin"
                 Dense="Dense"
                 Clearable="Clearable"
                 Disabled="Disabled"
                 Class="@Class"
                 Style="@Style"
                 Immediate="true"
                 DebounceInterval="150"
                 MaxItems="@TopeResultados" />

@code {
    /// <summary>Los elementos elegibles. La búsqueda filtra sobre esta lista en memoria.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>El identificador de cada elemento: lo que se guarda, nunca lo que se ve.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, TValue> ValorDe { get; set; } = static _ => default!;

    /// <summary>El texto de cada elemento: lo que se ve, nunca el identificador.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, string> TextoDe { get; set; } = static _ => string.Empty;

    /// <summary>El valor seleccionado.</summary>
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Lo usa EditForm para la validación; se recibe por @bind-Value.</summary>
    [Parameter]
    public Expression<Func<TValue>>? ValueExpression { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public Margin Margin { get; set; } = Margin.Dense;

    [Parameter]
    public bool Dense { get; set; }

    /// <summary>Solo tiene sentido cuando TValue es nullable (Guid?, int?...).</summary>
    [Parameter]
    public bool Clearable { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Nombre legible del valor actual cuando ya no está en la lista — el clásico: la categoría
    /// del producto fue desactivada y el filtro de activos la sacó del combo. Se toma del
    /// registro que se está editando, que ya trae el nombre resuelto, para no perder la
    /// información de cuál era.
    /// </summary>
    [Parameter]
    public string? TextoValorActual { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    /// <summary>
    /// Cuántos resultados mostrar como máximo. La búsqueda existe justamente para no leer todo;
    /// sin tope, un catálogo de diez mil productos abriría el desplegable con diez mil filas.
    /// </summary>
    [Parameter]
    public int TopeResultados { get; set; } = 100;

    private bool _esVacio => EqualityComparer<TValue>.Default.Equals(Value, default);

    /// <summary>El texto que muestra el combo cerrado. Nunca un identificador.</summary>
    private string? TextoDelValor(TValue? valor)
    {
        if (valor is null || EqualityComparer<TValue>.Default.Equals(valor, default))
        {
            return string.Empty;
        }

        var item = Items.FirstOrDefault(i => EqualityComparer<TValue>.Default.Equals(ValorDe(i), valor));

        if (item is not null)
        {
            return TextoDe(item);
        }

        // El valor ya no está en la lista: la ficha se desactivó o la lista se recargó. El
        // nombre lo trae el registro que se edita; sin eso, un guión — nunca el id.
        return TextoValorActual ?? "—";
    }

    /// <summary>
    /// La búsqueda: coincide por texto, sin importar mayúsculas ni tildes — escribir "pineo"
    /// encuentra "Piñeo", y "aceite 2t" encuentra "Aceite 2T". Sin texto, devuelve el catálogo
    /// completo (recortado al tope) para que abrir el combo siga sirviendo para mirar.
    /// </summary>
    private Task<IEnumerable<TValue>> BuscarAsync(string texto, CancellationToken cancellation)
    {
        IEnumerable<TItem> candidatos = Items;

        if (!string.IsNullOrWhiteSpace(texto))
        {
            var buscado = Normalizar(texto);
            candidatos = Items.Where(i => Normalizar(TextoDe(i)).Contains(buscado, StringComparison.Ordinal));
        }

        var valores = candidatos.Take(TopeResultados).Select(ValorDe).ToList();

        // El valor actual solo se agrega cuando se navega sin filtro. Al escribir, agregarlo
        // aunque no coincida ensucia la búsqueda (escribir "hotel" y ver la conexión actual,
        // que no es ningún hotel, hace pensar que el filtro no funciona). Si el valor cayó fuera
        // de la lista activa —ficha desactivada—, sin texto sigue estando y se puede re-elegir.
        if (string.IsNullOrWhiteSpace(texto)
            && !_esVacio
            && valores.All(v => !EqualityComparer<TValue>.Default.Equals(v, Value)))
        {
            valores.Add(Value!);
        }

        return Task.FromResult<IEnumerable<TValue>>(valores);
    }

    /// <summary>Quita mayúsculas y tildes: la búsqueda no debe exigir que quien busca teclee perfecto.</summary>
    private static string Normalizar(string texto)
    {
        var sinTildes = texto.Normalize(NormalizationForm.FormD);

        var builder = new StringBuilder(sinTildes.Length);
        foreach (var c in sinTildes)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(c);
            }
        }

        return builder.ToString().Normalize(NormalizationForm.FormC).ToLowerInvariant();
    }

    private Task OnCambio(TValue valor) => ValueChanged.InvokeAsync(valor);
}
