@* Alta y edición de técnico del catálogo compartido (D-21). *@
<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Modelo.Codigo" Label="Código" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="EsEdicion" Required="true" RequiredError="Ponga un código" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="Modelo.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Modelo.Cargo" Label="Cargo" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Modelo.Telefono" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="Modelo.Correo" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="Modelo.Orden" Label="Orden" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            @* Color del calendario de este técnico en la agenda. Se guarda en el catálogo compartido
               (D-21); si se deja vacío la agenda le asigna uno determinístico por código. *@
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="Modelo.ColorCalendario" Label="Color calendario" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Placeholder="#1976D2" />
            </MudItem>
            <MudItem xs="12" md="1">
                <input type="color" value="@ColorSeguro" style="width:100%;height:38px;border:1px solid #ccc;border-radius:4px;"
                       @onchange="@((ChangeEventArgs e) => Modelo.ColorCalendario = e.Value?.ToString())"
                       aria-label="Elegir color del calendario" />
            </MudItem>
            @if (EsEdicion)
            {
                <MudItem xs="12" md="1">
                    <MudSwitch @bind-Value="Modelo.EsActivo" Label="Activo" Color="Color.Primary" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Aceptar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = null!;

    [Parameter, EditorRequired]
    public TecnicoModel Modelo { get; set; } = new();

    private bool EsEdicion => Modelo.Id != Guid.Empty;

    private string ColorSeguro => Modelo.ColorCalendario is { Length: 7 } c && c.StartsWith('#') ? c : "#1976D2";

    private void Aceptar() => Dialogo.Close(DialogResult.Ok(Modelo));

    private void Cancelar() => Dialogo.Cancel();
}
