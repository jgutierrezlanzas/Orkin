@* Confirmación genérica: sí o no, con el mensaje en claro. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-3">@Titulo</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Mensaje</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirmar">
            <MudText>Confirmar</MudText>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = null!;

    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Mensaje { get; set; } = "";

    private void Confirmar() => Dialogo.Close(DialogResult.Ok(true));
    private void Cancelar() => Dialogo.Cancel();
}
