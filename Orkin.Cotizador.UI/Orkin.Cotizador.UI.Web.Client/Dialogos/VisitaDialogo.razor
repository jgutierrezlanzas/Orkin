@* Alta y edición de una visita sobre las tablas legacy existentes (D-22). Los códigos del ERP
   (locación, vehículo) se capturan como texto, igual que en PlantillaDialogo: no se copia ningún
   catálogo a una tabla local (D-20). El consecutivo ID_VISITA lo asigna la API. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Primary">
            @(EsEdicion ? $"Visita {Modelo.IdVisita}" : "Nueva visita")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudSelect T="string?" @bind-Value="Modelo.Cliente" Label="Cliente" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Dense="true" Clearable="true" Required="true" RequiredError="Seleccione un cliente">
                    @foreach (var cliente in _clientes)
                    {
                        <MudSelectItem T="string?" Value="@cliente.Codigo">@cliente.Codigo — @cliente.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Modelo.Locacion" Label="Locación (código ERP)" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string?" @bind-Value="Modelo.TipoServicio" Label="Tipo de servicio" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Dense="true" Clearable="true">
                    @foreach (var servicio in _servicios)
                    {
                        <MudSelectItem T="string?" Value="@servicio.Codigo">@servicio.Codigo — @servicio.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudDatePicker Date="@FechaInicioComoDateTime" DateChanged="@((DateTime? v) => Modelo.FechaInicio = v is null ? null : DateOnly.FromDateTime(v.Value))"
                               Label="Fecha inicio" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTimePicker Time="Modelo.HoraInicio" TimeChanged="@((TimeSpan? v) => Modelo.HoraInicio = v)"
                               Label="Hora inicio" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Date="@FechaFinalComoDateTime" DateChanged="@((DateTime? v) => Modelo.FechaFinal = v is null ? null : DateOnly.FromDateTime(v.Value))"
                               Label="Fecha final" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTimePicker Time="Modelo.HoraFinal" TimeChanged="@((TimeSpan? v) => Modelo.HoraFinal = v)"
                               Label="Hora final" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Modelo.CodigoVehiculo" Label="Vehículo (código ERP)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="long?" @bind-Value="Modelo.Plantilla" Label="Plantilla de orden de trabajo" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Dense="true" Clearable="true" Required="true" RequiredError="Seleccione una plantilla">
                    @foreach (var plantilla in _plantillas)
                    {
                        <MudSelectItem T="long?" Value="@plantilla.Plantilla">@plantilla.Plantilla — @plantilla.ClienteNombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Modelo.IdCalendario" Label="Evento / ID calendario (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="Si se deja vacío se genera ORKIN-{Guid}." />
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="string" @bind-SelectedValues="_tecnicosSeleccionados" Label="Técnicos" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Dense="true" SelectionMode="SelectionMode.Multiple" Required="true" RequiredError="Seleccione al menos un técnico">
                    @foreach (var tecnico in _tecnicos.Where(t => t.EsActivo))
                    {
                        <MudSelectItem T="string" Value="@tecnico.Codigo">@tecnico.Codigo — @tecnico.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Modelo.Nota" Label="Nota" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                              MaxLength="250" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Aceptar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = null!;

    [Parameter, EditorRequired]
    public VisitaGuardarModel Modelo { get; set; } = new();

    [Inject]
    private CatalogoService Catalogos { get; set; } = null!;

    [Inject]
    private PlantillaService ServicioPlantillas { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private List<ClienteModel> _clientes = [];
    private List<TecnicoModel> _tecnicos = [];
    private List<TipoServicioModel> _servicios = [];
    private List<PlantillaModel> _plantillas = [];
    private IReadOnlyCollection<string> _tecnicosSeleccionados = new List<string>();
    private string? _error;

    private bool EsEdicion => Modelo.IdVisita > 0;

    private DateTime? FechaInicioComoDateTime => Modelo.FechaInicio is { } f ? f.ToDateTime(TimeOnly.MinValue) : null;

    private DateTime? FechaFinalComoDateTime => Modelo.FechaFinal is { } f ? f.ToDateTime(TimeOnly.MinValue) : null;

    protected override async Task OnInitializedAsync()
    {
        var tareas = new Task[]
        {
            Cargar(() => Catalogos.ListarClientesAsync(), lista => _clientes = lista),
            Cargar(() => Catalogos.ListarTecnicosAsync(), lista => _tecnicos = lista),
            Cargar(() => Catalogos.ListarTiposServicioAsync(), lista => _servicios = lista),
            Cargar(() => ServicioPlantillas.ListarAsync(), lista => _plantillas = lista)
        };
        await Task.WhenAll(tareas);
        _tecnicosSeleccionados = Modelo.Tecnicos
            .Select(t => t.CodigoTecnico)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c!.Trim())
            .ToList();
    }

    private static async Task Cargar<T>(Func<Task<List<T>>> obtener, Action<List<T>> asignar)
        => asignar(await obtener());

    private void Aceptar()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(Modelo.Cliente))
        {
            _error = "Seleccione un cliente.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Modelo.Locacion))
        {
            _error = "Ingrese la locación (código ERP).";
            return;
        }

        if (Modelo.FechaInicio is null)
        {
            _error = "Seleccione la fecha de inicio.";
            return;
        }

        if (Modelo.Plantilla is null or <= 0)
        {
            _error = "Seleccione una plantilla de orden de trabajo.";
            return;
        }

        var codigos = _tecnicosSeleccionados
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (codigos.Count == 0)
        {
            _error = "Seleccione al menos un técnico.";
            return;
        }

        // El catálogo compartido de técnicos no expone INICIALES (varchar 2 del legacy), así que
        // al editar se conservan las que ya tenía la visita y al dar de alta se dejan vacías: la
        // columna legacy es opcional y el SP de OT trabaja con CODIGO_TECNICO.
        var inicialesPrevias = Modelo.Tecnicos
            .Where(t => !string.IsNullOrWhiteSpace(t.Iniciales))
            .ToDictionary(
                t => t.CodigoTecnico ?? string.Empty,
                t => t.Iniciales!,
                StringComparer.OrdinalIgnoreCase);
        Modelo.Tecnicos = codigos.Select(c => new VisitaTecnicoModel
        {
            CodigoTecnico = c,
            Iniciales = inicialesPrevias.GetValueOrDefault(c)
        }).ToList();

        if (Modelo.FechaFinal is null)
        {
            Modelo.FechaFinal = Modelo.FechaInicio;
        }

        if (Modelo.HoraFinal is null)
        {
            Modelo.HoraFinal = Modelo.HoraInicio;
        }

        Dialogo.Close(DialogResult.Ok(Modelo));
    }

    private void Cancelar() => Dialogo.Cancel();
}
