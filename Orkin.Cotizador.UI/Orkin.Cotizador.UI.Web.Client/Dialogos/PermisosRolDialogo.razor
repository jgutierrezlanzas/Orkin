@* Editor de permisos de un rol, reconstruido. Ver ProductoDialogo para el patrón.

   La versión anterior usaba MudCheckBox con T="string" (el código del permiso como valor) y
   Checked como parámetro separado — el estado nunca fluyó y quien marcaba un casillero veía
   que al guardar no cambiaba nada. Esta versión usa el patrón que funciona: cada casillero es
   un MudCheckBox de bool con @bind-Value sobre un diccionario, y el estado vive en el
   componente, no en un parámetro que el padre no puede ver cambiar.

   Se muestra el catálogo COMPLETO agrupado por módulo, no solo lo que el rol tiene: quien
   edita necesita ver qué puede quitar, no adivinar qué falta.
*@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Marque lo que este rol puede hacer. La lista reemplaza la anterior completa.
            El cambio surte efecto en el próximo ingreso de cada usuario.
        </MudText>

        @foreach (var grupo in _grupos)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-3 mb-1">@grupo.Key</MudText>
            <MudDivider Class="mb-2" />
            @foreach (var permiso in grupo)
            {
                var codigo = permiso.Codigo;
                <MudCheckBox T="bool" @bind-Value="@_marcados[codigo]"
                             Label="@permiso.Nombre"
                             HelperText="@(string.IsNullOrEmpty(permiso.Descripcion) ? null : permiso.Descripcion)"
                             Class="mb-1" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">
            <MudText>Guardar (@(_marcados.Values.Count(v => v)) permisos)</MudText>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = null!;

    [Parameter, EditorRequired]
    public RolModel Rol { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<PermisoModel> Permisos { get; set; } = [];

    [Parameter, EditorRequired]
    public HashSet<string> PermisosActuales { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// El estado vive AQUÍ, en un diccionario bool por código de permiso, y se enlaza con
    /// @bind-Value. Un HashSet que llega como parámetro y se muta desde adentro no dispara
    /// el repintado: el casillero parecía congelado y al guardar no cambiaba nada.
    /// </summary>
    private Dictionary<string, bool> _marcados = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Permisos agrupados por módulo, en el orden del catálogo.</summary>
    private IEnumerable<IGrouping<string, PermisoModel>> _grupos
        => Permisos.GroupBy(p => p.Modulo);

    protected override void OnInitialized()
    {
        foreach (var permiso in Permisos)
        {
            _marcados[permiso.Codigo] = PermisosActuales.Contains(permiso.Codigo);
        }
    }

    private void Guardar()
    {
        var seleccionados = _marcados
            .Where(kv => kv.Value)
            .Select(kv => kv.Key)
            .ToList();

        Dialogo.Close(DialogResult.Ok<IReadOnlyList<string>>(seleccionados));
    }

    private void Cancelar() => Dialogo.Cancel();
}
