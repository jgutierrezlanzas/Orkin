@* Alta y edición de plantilla de orden de trabajo sobre las tablas legacy existentes (D-22).
   Los códigos del ERP (locación, vehículo, plaga, ubicación, dosificación, método, frecuencia y
   equipo) se eligen de un combo legible leído desde las vistas vv* por la API de catálogos (D-20/D-21):
   se guarda el código, se muestra su descripción. Ningún catálogo se copia ni se crea (D-22). *@
<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            @if (EsEdicion)
            {
                <MudItem xs="12" md="2">
                    <MudTextField Value="@Modelo.Plantilla" Label="Plantilla" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                </MudItem>
            }
            <MudItem xs="12" md="@(EsEdicion ? 5 : 6)">
                <MudSelect T="string?" @bind-Value="Modelo.Cliente" Label="Cliente" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                           Required="true" RequiredError="Seleccione un cliente">
                    @foreach (var cliente in _clientes)
                    {
                        <MudSelectItem T="string?" Value="@cliente.Codigo">@cliente.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="@(EsEdicion ? 5 : 6)">
                <MudSelect T="string?" @bind-Value="Modelo.Tecnico" Label="Técnico (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var tecnico in _tecnicos)
                    {
                        <MudSelectItem T="string?" Value="@tecnico.Codigo">@tecnico.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                 Items="@LocacionesDisponibles" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                 Value="@(Modelo.Locacion ?? string.Empty)"
                                 ValueChanged="@(v => Modelo.Locacion = v)"
                                 TextoValorActual="@TextoActual(Modelo.Locacion, _opciones.Locaciones)"
                                 Label="Locación" Clearable="true"
                                 HelperText="Se listan las locaciones del cliente seleccionado." />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="Modelo.Direccion" Label="Dirección" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="Modelo.Contacto" Label="Contacto" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="Modelo.Telefono" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                 Items="_opciones.Vehiculos" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                 Value="@(Modelo.Vehiculo ?? string.Empty)"
                                 ValueChanged="@(v => Modelo.Vehiculo = v)"
                                 TextoValorActual="@TextoActual(Modelo.Vehiculo, _opciones.Vehiculos)"
                                 Label="Vehículo (opcional)" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="Modelo.DescripcionTrabajo" Label="Descripción del trabajo" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string?" @bind-Value="Modelo.Activo" Label="Activo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string?" Value="@("SI")">SI</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("NO")">NO</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Modelo.Notas" Label="Notas" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
        </MudGrid>

        <MudTabs Elevation="0" Outlined="true" Class="mt-4" Rounded="true">
            <MudTabPanel Text="Productos" Icon="@Icons.Material.Filled.Inventory">
                <div class="d-flex justify-end pa-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarDetalle">Agregar producto</MudButton>
                </div>
                @foreach (var linea in Modelo.Detalles.OrderBy(d => d.Consecutivo))
                {
                    <MudPaper Class="pa-3 mb-3" Elevation="1" Outlined="true">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.subtitle2">Línea @linea.Consecutivo</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => Modelo.Detalles.Remove(linea))" aria-label="Quitar línea" />
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string?" Value="linea.CodigoArticulo" ValueChanged="@((string? v) => AlCambiarProducto(linea, v))"
                                           Label="Artículo (código ERP)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                                    @foreach (var producto in _productos)
                                    {
                                        <MudSelectItem T="string?" Value="@producto.Codigo">@producto.Codigo — @producto.Nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="linea.DescripArticulo" Label="Descripción del artículo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField Value="linea.Cantidad" ValueChanged="@((decimal? v) => { linea.Cantidad = v; Recalcular(linea); })"
                                                 Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                @* UMEDIDA se conserva tal como viene del ERP (UNIDAD_VENTA), sin normalizar. *@
                                <SelectorLegible TItem="UnidadMedidaModel" TValue="string"
                                                 Items="_unidadesMedida" ValorDe="u => u.Abreviatura" TextoDe="TextoUnidad"
                                                 Value="@(linea.Umedida ?? string.Empty)"
                                                 ValueChanged="@(v => linea.Umedida = v)"
                                                 TextoValorActual="@(string.IsNullOrWhiteSpace(linea.Umedida) ? string.Empty : $"Unidad ERP: {linea.Umedida}")"
                                                 Label="Unidad" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Plagas" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.TipoPlaga ?? string.Empty)"
                                                 ValueChanged="@(v => linea.TipoPlaga = v)"
                                                 TextoValorActual="@TextoActual(linea.TipoPlaga, _opciones.Plagas)"
                                                 Label="Tipo de plaga" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Ubicaciones" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.LugarTratar ?? string.Empty)"
                                                 ValueChanged="@(v => linea.LugarTratar = v)"
                                                 TextoValorActual="@TextoActual(linea.LugarTratar, _opciones.Ubicaciones)"
                                                 Label="Lugar a tratar" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField @bind-Value="linea.Area" Label="Área" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField @bind-Value="linea.Concentracion" Label="Concentración" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Dosificaciones" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.CodigoDosificacion ?? string.Empty)"
                                                 ValueChanged="@(v => linea.CodigoDosificacion = v)"
                                                 TextoValorActual="@TextoActual(linea.CodigoDosificacion, _opciones.Dosificaciones)"
                                                 Label="Dosificación" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Metodos" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.MetodoAplicacion ?? string.Empty)"
                                                 ValueChanged="@(v => linea.MetodoAplicacion = v)"
                                                 TextoValorActual="@TextoActual(linea.MetodoAplicacion, _opciones.Metodos)"
                                                 Label="Método de aplicación" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField Value="linea.CostoUnitario" ValueChanged="@((decimal? v) => { linea.CostoUnitario = v; Recalcular(linea); })"
                                                 Label="Costo unit." Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField @bind-Value="linea.CostoTotal" Label="Costo total" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField @bind-Value="linea.MaximoPermitido" Label="Máximo permitido" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
                @if (Modelo.Detalles.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Sin productos. La plantilla requiere al menos uno.</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="Servicios" Icon="@Icons.Material.Filled.CleaningServices">
                <div class="d-flex justify-end pa-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarServicio">Agregar servicio</MudButton>
                </div>
                @foreach (var linea in Modelo.Servicios.OrderBy(s => s.Consecutivo))
                {
                    <MudPaper Class="pa-3 mb-3" Elevation="1" Outlined="true">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => Modelo.Servicios.Remove(linea))" aria-label="Quitar servicio" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudSelect T="string" @bind-Value="linea.CodigoServicio" Label="Tipo de servicio" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                                    @foreach (var servicio in _tiposServicio)
                                    {
                                        <MudSelectItem T="string" Value="@servicio.Codigo">@servicio.Nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Frecuencias" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.CodigoFrecuencia ?? string.Empty)"
                                                 ValueChanged="@(v => linea.CodigoFrecuencia = v)"
                                                 TextoValorActual="@TextoActual(linea.CodigoFrecuencia, _opciones.Frecuencias)"
                                                 Label="Frecuencia" Clearable="true" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
                @if (Modelo.Servicios.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Sin servicios. La plantilla requiere al menos uno.</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="Equipos" Icon="@Icons.Material.Filled.Build">
                <div class="d-flex justify-end pa-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarEquipo">Agregar equipo</MudButton>
                </div>
                @foreach (var linea in Modelo.Equipos.OrderBy(e => e.Consecutivo))
                {
                    <MudPaper Class="pa-3 mb-3" Elevation="1" Outlined="true">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => Modelo.Equipos.Remove(linea))" aria-label="Quitar equipo" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <SelectorLegible TItem="OpcionErpModel" TValue="string"
                                                 Items="_opciones.Equipos" ValorDe="o => o.Codigo" TextoDe="TextoOpcion"
                                                 Value="@(linea.CodigoEquipo ?? string.Empty)"
                                                 ValueChanged="@(v => linea.CodigoEquipo = v)"
                                                 TextoValorActual="@TextoActual(linea.CodigoEquipo, _opciones.Equipos)"
                                                 Label="Equipo" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                @* El legacy guarda UTILIZADO como SI/NO, no como bool. *@
                                <MudSelect T="string?" @bind-Value="linea.Utilizado" Label="Utilizado" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem T="string?" Value="@("SI")">SI</MudSelectItem>
                                    <MudSelectItem T="string?" Value="@("NO")">NO</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
                @if (Modelo.Equipos.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Sin equipos. La plantilla requiere al menos uno.</MudText>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Aceptar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlantillaModel Modelo { get; set; } = new();

    [Inject]
    private CatalogoService Catalogos { get; set; } = null!;

    private List<ClienteModel> _clientes = [];
    private List<TecnicoModel> _tecnicos = [];
    private List<ProductoModel> _productos = [];
    private List<TipoServicioModel> _tiposServicio = [];
    private List<UnidadMedidaModel> _unidadesMedida = [];
    private OpcionesErpModel _opciones = new();

    private bool EsEdicion => Modelo.Plantilla != 0;

    /// <summary>Las locaciones se acotan al cliente elegido; el código se guarda igual.</summary>
    private IReadOnlyList<OpcionErpModel> LocacionesDisponibles =>
        string.IsNullOrWhiteSpace(Modelo.Cliente)
            ? _opciones.Locaciones
            : _opciones.Locaciones
                .Where(l => string.Equals(l.Detalle, Modelo.Cliente.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        var tareas = new Task[]
        {
            Cargar(() => Catalogos.ListarClientesAsync(), lista => _clientes = lista),
            Cargar(() => Catalogos.ListarTecnicosAsync(), lista => _tecnicos = lista),
            Cargar(() => Catalogos.ListarProductosAsync(), lista => _productos = lista),
            Cargar(() => Catalogos.ListarTiposServicioAsync(), lista => _tiposServicio = lista),
            Cargar(() => Catalogos.ListarUnidadesMedidaAsync(), lista => _unidadesMedida = lista),
            CargarDato(() => Catalogos.ListarOpcionesErpAsync(), opciones => _opciones = opciones)
        };
        await Task.WhenAll(tareas);
    }

    private static async Task Cargar<T>(Func<Task<List<T>>> obtener, Action<List<T>> asignar)
        => asignar(await obtener());

    private static async Task CargarDato<T>(Func<Task<T>> obtener, Action<T> asignar)
        => asignar(await obtener());

    /// <summary>La descripción primero y el código entre paréntesis: nunca solo el código.</summary>
    private static string TextoOpcion(OpcionErpModel opcion)
    {
        var datos = new List<string> { opcion.Codigo };
        if (!string.IsNullOrWhiteSpace(opcion.Detalle))
        {
            datos.Add(opcion.Detalle.Trim());
        }

        if (!string.IsNullOrWhiteSpace(opcion.UnidadMedida))
        {
            datos.Add(opcion.UnidadMedida.Trim());
        }

        return $"{opcion.Descripcion} ({string.Join(" · ", datos)})";
    }

    private static string TextoUnidad(UnidadMedidaModel unidad)
        => $"{unidad.Nombre} ({unidad.Abreviatura})";

    /// <summary>
    /// Cuando el código legacy ya no está en la vista activa se muestra tal cual, pero etiquetado,
    /// para que quien edite entienda que es un dato heredado y no una opción del catálogo.
    /// </summary>
    private static string TextoActual(string? codigo, IReadOnlyList<OpcionErpModel> opciones)
    {
        if (string.IsNullOrWhiteSpace(codigo))
        {
            return string.Empty;
        }

        var texto = codigo.Trim();
        var opcion = opciones.FirstOrDefault(o =>
            string.Equals(o.Codigo, texto, StringComparison.OrdinalIgnoreCase));
        return opcion is null ? $"Código heredado: {texto}" : TextoOpcion(opcion);
    }

    private void AgregarDetalle() => Modelo.Detalles.Add(new PlantillaDetalleModel
    {
        Consecutivo = Modelo.Detalles.Count + 1,
        Cantidad = 1,
        CostoTotal = 0
    });

    private void AgregarServicio() => Modelo.Servicios.Add(new PlantillaServicioModel
    {
        Consecutivo = Modelo.Servicios.Count + 1
    });

    private void AgregarEquipo() => Modelo.Equipos.Add(new PlantillaEquipoModel
    {
        Consecutivo = Modelo.Equipos.Count + 1,
        Utilizado = "SI"
    });

    private void AlCambiarProducto(PlantillaDetalleModel linea, string? codigoArticulo)
    {
        linea.CodigoArticulo = codigoArticulo;
        var producto = _productos.FirstOrDefault(p => p.Codigo == codigoArticulo);
        if (producto is null)
        {
            return;
        }

        linea.DescripArticulo = producto.Nombre;
        linea.Umedida = producto.UnidadMedidaAbreviatura ?? producto.UnidadMedidaNombre;
        linea.CostoUnitario = producto.CostoActual;
        Recalcular(linea);
    }

    /// <summary>COSTO_TOTAL se calcula igual que en el WinForms: CANTIDAD × COSTO_UNITARIO.</summary>
    private static void Recalcular(PlantillaDetalleModel linea)
        => linea.CostoTotal = (linea.Cantidad ?? 0) * (linea.CostoUnitario ?? 0);

    private void Aceptar() => Dialogo.Close(DialogResult.Ok(Modelo));

    private void Cancelar() => Dialogo.Cancel();
}
