# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración/secretos de DESARROLLO. Copiar como ".env.Development".
#
#   Copy-Item .env.Development.example .env.Development      (PowerShell)
#   cp .env.Development.example .env.Development             (bash)
#
# El nombre tiene que coincidir con ASPNETCORE_ENVIRONMENT, porque ConfiguracionBootstrap
# arma la cascada así: .env, luego .env.{ENTORNO}, luego .env.local. Un archivo con
# otro nombre se carga bien y no se encuentra nunca.
#
# Este archivo SÍ se versiona; la copia con valores reales, NO. Los nombres de
# variable de acá son los mismos que se registrarán como secrets en GitHub
# cuando se configuren los despliegues (RENOMBRARLOS ROMPE LA CONFIGURACIÓN:
# los dobles guiones bajos son la convención de .NET para secciones, p. ej.
# Database__ConnectionString -> Configuration["Database:ConnectionString"]).
#
# ── Por qué los secretos van aquí y no en appsettings.Development.json ──────────
# Un appsettings se versiona, y lo que está versionado termina en el historial de Git para
# siempre: aunque después lo borres, sigue ahí, en el commit viejo, y un archivo .env
# empieza en .gitignore. Además, un .env se puede cambiar en un despliegue sin tocar el
# repositorio, que es justo lo que se necesita para rotar una clave sin recompilar.
#
# ── Precedencia (de menor a mayor) ──────────────────────────────────────────────
# appsettings.json  <  appsettings.{Entorno}.json  <  .env  <  .env.{Entorno}  <  .env.local
#                                                  <  variables de ambiente reales
# Las variables de ambiente reales (las que inyecta Docker o GitHub Actions) ganan
# siempre: un .env es el valor por defecto del entorno, no una forma de forzar uno.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ───────────────────────────────────────────────────────────────
# Cadena completa. En desarrollo apunta a SINCOERPORKIN, la BD principal del sistema.
# La BD local "Orkin" del contenedor db se mantiene solo como respaldo de desarrollo.
#
# El nombre de la base es "SINCOERPORKIN", sin sufijo de módulo, a propósito: la
# plataforma va a crecer y a tener más módulos (el cotizador es el primero, no el único).
#
# OJO con el nombre de la clave: es "Database__ConnectionString". No es
# "ConnectionStrings__CotizadorDb" —ese es el nombre que usa la plantilla de ASP.NET para
# otra cosa— porque acá el binder solo conoce la sección "Database". Con el nombre
# equivocado la aplicación no dice "falta la cadena": dice que la cadena está vacía, y el
# error aparece como un fallo de conexión mucho más abajo.
Database__ConnectionString=Server=10.40.50.1,1433;Database=SINCOERPORKIN;User Id=Desarrollo;Password=CAMBIAR_ESTA_CLAVE;TrustServerCertificate=True;Encrypt=False

# Aplica migraciones pendientes al arrancar. En desarrollo true; en producción se
# suele dejar en false y aplicarlas en un paso explícito del despliegue.
Database__AplicarMigracionesAlArrancar=true

# ── Seguridad ───────────────────────────────────────────────────────────────────
# Clave de firma del JWT. Simétrica, HMAC-SHA256: la misma la usa la API para emitir y
# para validar, porque emitir y validar ocurren en el mismo proceso (ADR-007).
#
# Tiene que tener al menos 32 bytes, y el arranque falla si no. Generar una:
#
#   openssl rand -base64 48
#
# En Windows, sin OpenSSL:
#
#   $bytes = New-Object byte[] 48
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
Seguridad__ClaveFirma=CAMBIAR_ESTA_CLAVE

# ── Correo saliente (Fase 8) ───────────────────────────────────────────────────
# El legacy no tenía envío de correo: no hay SmtpClient ni credenciales que reutilizar.
# Todo se configura acá. Habilitado=false por defecto a propósito: encender el envío
# real es una decisión explícita, y un despliegue nuevo no debe mandar correos a
# destinatarios reales por accidente.
Correo__Habilitado=false
Correo__Servidor=smtp.ejemplo.local
Correo__Puerto=587
Correo__UsarSsl=true
Correo__Usuario=
Correo__Clave=
Correo__De=notificaciones@ejemplo.local
Correo__NombreDe=ORKIN
Correo__TimeoutSegundos=30

# ── Job de notificaciones y bandeja (Fase 8) ───────────────────────────────────
# El job también queda apagado: la API, la bandeja y los endpoints manuales
# (recoger/procesar) funcionan igual. Habilitarlo sí envía lo que haya en la cola.
Notificaciones__HabilitadoJob=false
Notificaciones__IntervaloSegundos=60
Notificaciones__TamanoLote=20
Notificaciones__MaximoIntentos=3
Notificaciones__BackoffBaseSegundos=60
# No desactivar en producción: es la barrera que comprueba OBJECT_DEFINITION y
# permisos EXECUTE antes de invocar los SPs SINCO_NOTIFICAR_*.
Notificaciones__ValidarDefinicionesSp=true
# Los SPs de requisas erradas no traen correo. Vacío desactiva ese aviso; no se
# inventa una dirección de relleno.
Notificaciones__CorreoInterno=
Notificaciones__TamanoBandeja=50

# ── CORS: orígenes de la web en debug ──────────────────────────────────────────
# La web (Blazor WASM) corre aparte y consume la API desde estos orígenes.
Cors__Origenes__0=http://localhost:59093
Cors__Origenes__1=https://localhost:59090

# ── Semilla de catálogos ────────────────────────────────────────────────────────
# Estas no llevan el prefijo de sección a propósito: las escribe alguien que está
# copiando una instrucción de un manual, no alguien que abrió el proyecto y está leyendo
# la clase SemillaOptions. Por eso se leen sueltas, después de enlazar la sección.
#
# RUN_SEED carga los JSON de scripts/seed/. Es idempotente por Codigo: volver a correrlo
# no duplica nada, y por eso se puede dejar en true en desarrollo sin vigilarlo.
RUN_SEED=true

# El usuario administrador inicial. Solo se crea si no existe ya ninguno, así que ponerlo
# acá no regenera nada en la segunda corrida.
CREATE_ADMIN_USER=true
ADMIN_EMAIL=admin@orkin.local

# OJO: tiene que cumplir la política de Identity —10 caracteres, una mayúscula y un dígito—,
# y esa política no es la misma en todos los ambientes. Esta contraseña se guarda hasheada y
# no se vuelve a leer del .env, así que cambiarla acá después no cambia nada: hay que
# cambiarla desde la pantalla de la aplicación.
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE

# ── SQL Server local del contenedor db (solo respaldo de desarrollo) ────────────
# El contenedor "db" de docker-compose levanta una base Orkin local. NO es la BD
# principal: la API apunta a SINCOERPORKIN. Se mantiene como respaldo de desarrollo.
MSSQL_SA_PASSWORD=CAMBIAR_ESTA_CLAVE
