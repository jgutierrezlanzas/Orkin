{
  "Database": {
    "AplicarMigracionesAlArrancar": true,
    "EnableSensitiveDataLogging": true
  },

  "Seed": {
    "Ejecutar": true
  },

  "Cors": {
    "Origenes": ["http://localhost:59793", "https://localhost:59790"]
  },

  "Swagger": {
    "Enable": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Orkin.Cotizador": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
