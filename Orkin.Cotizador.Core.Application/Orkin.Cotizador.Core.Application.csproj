<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orkin.Cotizador.Core.Application</RootNamespace>
    <Configurations>Debug;Release;Staging</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <!--
      Solo las abstracciones, y solo por el motor de sincronizacion programada
      (SincronizacionBackgroundService): BackgroundService y PeriodicTimer viven acá. Van en esta
      capa y no en infraestructura porque el motor necesita a IntegracionService, que es de
      aplicacion, y la dependencia entre capas va en un solo sentido. Se traen las abstracciones y
      no el paquete entero para que esta capa siga sin saber como se hospeda.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkin.Cotizador.Core.Domain\Orkin.Cotizador.Core.Domain.csproj" />
    <ProjectReference Include="..\Orkin.Cotizador.Core.Infrastructure\Orkin.Cotizador.Core.Infrastructure.csproj" />
  </ItemGroup>

</Project>
